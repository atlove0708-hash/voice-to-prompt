#!/bin/bash
# vp-history - Voice to Prompt 履歴ビューア
# 使い方:
#   vp-history          全履歴を表示
#   vp-history search キーワード   検索
#   vp-history today    今日の履歴
#   vp-history copy 3   3番目の履歴をクリップボードにコピー
#   vp-history export   全履歴をCSVにエクスポート

HISTORY="$HOME/Desktop/voice-input/history/voice_history.jsonl"
G='\033[0;32m' C='\033[0;36m' Y='\033[1;33m' R='\033[0;31m' B='\033[1m' D='\033[2m' N='\033[0m'

if [ ! -f "$HISTORY" ]; then
    echo -e "\n  ${Y}履歴がまだありません。Shift+Space で音声入力してください。${N}\n"
    exit 0
fi

show_entries() {
    # $1 = jqフィルタ or 全件
    local data="$1"
    local count=0
    echo ""
    echo -e "  ${B}━━━ Voice to Prompt 履歴 ━━━${N}"
    echo ""

    while IFS= read -r line; do
        [ -z "$line" ] && continue
        count=$((count + 1))

        ts=$(echo "$line" | python3 -c "import sys,json;d=json.loads(sys.stdin.read());print(d.get('timestamp','?'))" 2>/dev/null)
        raw=$(echo "$line" | python3 -c "import sys,json;d=json.loads(sys.stdin.read());print(d.get('raw','')[:80])" 2>/dev/null)
        prompt=$(echo "$line" | python3 -c "import sys,json;d=json.loads(sys.stdin.read());print(d.get('prompt','')[:80])" 2>/dev/null)
        ok=$(echo "$line" | python3 -c "import sys,json;d=json.loads(sys.stdin.read());print('✅' if d.get('success') else '⚠️')" 2>/dev/null)

        echo -e "  ${B}#${count}${N} ${D}${ts}${N} ${ok}"
        echo -e "  ${D}音声:${N} ${raw}"
        echo -e "  ${C}変換:${N} ${prompt}"
        echo ""
    done <<< "$data"

    if [ $count -eq 0 ]; then
        echo -e "  ${Y}該当する履歴がありません${N}"
    else
        echo -e "  ${D}計 ${count} 件${N}"
    fi
    echo ""
}

case "${1:-list}" in
    list|"")
        # 最新20件を逆順で表示
        data=$(tail -20 "$HISTORY")
        show_entries "$data"
        echo -e "  ${D}コマンド: vp-history search <キーワード> / vp-history copy <番号> / vp-history today${N}"
        echo ""
        ;;

    search|find|grep)
        keyword="$2"
        if [ -z "$keyword" ]; then
            echo -e "\n  ${R}検索キーワードを指定してください${N}"
            echo -e "  例: vp-history search 営業\n"
            exit 1
        fi
        data=$(grep -i "$keyword" "$HISTORY")
        echo -e "\n  ${C}「${keyword}」の検索結果:${N}"
        show_entries "$data"
        ;;

    today)
        today=$(date +%Y-%m-%d)
        data=$(grep "$today" "$HISTORY")
        echo -e "\n  ${C}今日 (${today}) の履歴:${N}"
        show_entries "$data"
        ;;

    date)
        target="$2"
        if [ -z "$target" ]; then
            echo -e "\n  ${R}日付を指定してください (例: vp-history date 2026-04-02)${N}\n"
            exit 1
        fi
        data=$(grep "$target" "$HISTORY")
        echo -e "\n  ${C}${target} の履歴:${N}"
        show_entries "$data"
        ;;

    copy|restore)
        num="$2"
        if [ -z "$num" ]; then
            echo -e "\n  ${R}番号を指定してください (例: vp-history copy 3)${N}\n"
            exit 1
        fi
        # 最新N件から指定番号を取得
        line=$(tail -20 "$HISTORY" | sed -n "${num}p")
        if [ -z "$line" ]; then
            echo -e "\n  ${R}#${num} の履歴が見つかりません${N}\n"
            exit 1
        fi
        prompt=$(echo "$line" | python3 -c "import sys,json;d=json.loads(sys.stdin.read());print(d.get('prompt',''))" 2>/dev/null)
        echo "$prompt" | pbcopy
        echo -e "\n  ${G}✅ #${num} のプロンプトをクリップボードにコピーしました${N}"
        echo -e "  ${C}${prompt}${N}\n"
        ;;

    export)
        csv_file="$HOME/Desktop/voice_history_$(date +%Y%m%d).csv"
        echo "timestamp,raw,prompt,success" > "$csv_file"
        while IFS= read -r line; do
            [ -z "$line" ] && continue
            python3 -c "
import sys,json,csv,io
d=json.loads(sys.argv[1])
w=csv.writer(sys.stdout)
w.writerow([d.get('timestamp',''),d.get('raw',''),d.get('prompt',''),d.get('success','')])
" "$line" >> "$csv_file" 2>/dev/null
        done < "$HISTORY"
        echo -e "\n  ${G}✅ CSVにエクスポートしました: ${csv_file}${N}\n"
        ;;

    raw)
        # 指定番号の元音声テキストをコピー
        num="$2"
        line=$(tail -20 "$HISTORY" | sed -n "${num}p")
        if [ -z "$line" ]; then
            echo -e "\n  ${R}#${num} の履歴が見つかりません${N}\n"
            exit 1
        fi
        raw=$(echo "$line" | python3 -c "import sys,json;d=json.loads(sys.stdin.read());print(d.get('raw',''))" 2>/dev/null)
        echo "$raw" | pbcopy
        echo -e "\n  ${G}✅ #${num} の元音声テキストをコピーしました${N}"
        echo -e "  ${raw}\n"
        ;;

    help|--help|-h)
        echo ""
        echo -e "  ${B}vp-history${N} - Voice to Prompt 履歴管理"
        echo ""
        echo -e "  ${C}コマンド:${N}"
        echo "    vp-history              最新20件を表示"
        echo "    vp-history search <語>  キーワード検索"
        echo "    vp-history today        今日の履歴"
        echo "    vp-history date <日付>  指定日の履歴 (例: 2026-04-02)"
        echo "    vp-history copy <番号>  プロンプトをクリップボードにコピー"
        echo "    vp-history raw <番号>   元音声テキストをコピー"
        echo "    vp-history export       CSVにエクスポート"
        echo ""
        ;;

    *)
        echo -e "\n  ${R}不明なコマンド: $1${N}"
        echo -e "  vp-history help でヘルプを表示\n"
        ;;
esac
